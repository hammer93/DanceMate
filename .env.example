# DanceMate v0.74 environment template.
#
# Copy to .env and fill in real values. NEVER commit .env - it is git-ignored.
# Generate the PostgreSQL password at deployment time, e.g.
#   openssl rand -base64 24
#
# PATH CONVENTION: the *_DIR variables below name HOST paths used as Docker
# bind-mount sources. The container-side paths are pinned in docker-compose.yml
# (/app/engine/data, /var/lib/dancemate, /var/log/dancemate, /var/backups/dancemate)
# and always win over anything set here.

DANCEMATE_ENV=staging
DANCEMATE_VERSION=0.74

# LAN ONLY. No WAN port forwarding. Narrow this to the board's LAN address
# (e.g. 192.168.0.10) once the board address is fixed.
DANCEMATE_BIND_ADDRESS=0.0.0.0
DANCEMATE_HOST=0.0.0.0
DANCEMATE_PORT=8080

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dancemate
POSTGRES_USER=dancemate
POSTGRES_PASSWORD=CHANGE_ME

# Information Engine v0.73 keeps its own SQLite store (hybrid persistence).
ENGINE_VERSION=0.73
ENGINE_DATA_DIR=/var/lib/dancemate/engine

DANCEMATE_DATA_DIR=/var/lib/dancemate
DANCEMATE_LOG_DIR=/var/log/dancemate
DANCEMATE_BACKUP_DIR=/var/backups/dancemate

# Scheduler cadence. Floored at 30s in code: a microSD must not absorb
# per-second writes. 60s heartbeat / 300s job cycle is the staging default.
SCHEDULER_HEARTBEAT_SECONDS=60
SCHEDULER_JOB_INTERVAL_SECONDS=300

# Storage warning bands for /status and check-server.sh.
STORAGE_WARN_PERCENT=75
STORAGE_CRITICAL_PERCENT=95

# Keep the last N backups; warn when the newest is older than N hours.
BACKUP_RETENTION=7
BACKUP_MAX_AGE_HOURS=48

TZ=Asia/Seoul
