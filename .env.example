# DanceMate v0.74 environment template.
#
# Copy to .env and fill in real values. NEVER commit .env - it is git-ignored.
# Generate the PostgreSQL password at deployment time, e.g.
#   openssl rand -base64 24
#
# PATH CONVENTION: the *_DIR variables below name HOST paths used as Docker
# bind-mount sources. The container-side paths are pinned in docker-compose.yml
# (/app/engine/data, /var/lib/dancemate, /var/log/dancemate, /var/backups/dancemate)
# and always win over anything set here.

DANCEMATE_ENV=staging
DANCEMATE_VERSION=0.77.1

# Deployment shape - which compose file describes this deployment.
#   docker-compose.yml
#       self-contained stack with its own PostgreSQL (development default)
#   deploy/rockpro64/docker-compose.external-postgres.yml
#       ROCKPro64: runtime + scheduler only, against the board's existing
#       dancemate-postgres container on the dancemate-net network
DANCEMATE_COMPOSE_FILE=docker-compose.yml

# Only needed when the selected compose file has no postgres service of its
# own: the name of the PostgreSQL container backup/restore should talk to.
#DANCEMATE_POSTGRES_CONTAINER=dancemate-postgres
# External Docker network to join in that mode.
#DANCEMATE_NETWORK=dancemate-net

# Two different addresses - do not confuse them.
#
# DANCEMATE_BIND_ADDRESS: the HOST interface Docker publishes the port on.
#   LAN ONLY. No WAN port forwarding. Narrow this to the board's wired LAN
#   address (e.g. 192.168.0.10) so the API is not published on any other
#   interface. Read by docker compose and by the health scripts.
DANCEMATE_BIND_ADDRESS=0.0.0.0
#
# DANCEMATE_HOST: the address the server listens on INSIDE the container.
#   Keep 0.0.0.0. A container has no LAN address of its own, so putting the
#   host's LAN IP here makes uvicorn fail with "could not bind on any address".
#   Both compose files pin it to 0.0.0.0 so this cannot be got wrong.
DANCEMATE_HOST=0.0.0.0
DANCEMATE_PORT=8080

# Host the health scripts probe. Derived from DANCEMATE_BIND_ADDRESS when
# unset: loopback for 0.0.0.0, otherwise the bound address itself. Set this
# only when the checks run from a different machine than the runtime.
#DANCEMATE_HEALTH_HOST=127.0.0.1

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dancemate
POSTGRES_USER=dancemate
POSTGRES_PASSWORD=CHANGE_ME

# Information Engine v0.73 keeps its own SQLite store (hybrid persistence).
ENGINE_VERSION=0.73
ENGINE_DATA_DIR=/var/lib/dancemate/engine

DANCEMATE_DATA_DIR=/var/lib/dancemate
DANCEMATE_LOG_DIR=/var/log/dancemate
DANCEMATE_BACKUP_DIR=/var/backups/dancemate

# Scheduler cadence. Floored at 30s in code: a microSD must not absorb
# per-second writes. 60s heartbeat / 300s job cycle is the staging default.
SCHEDULER_HEARTBEAT_SECONDS=60
SCHEDULER_JOB_INTERVAL_SECONDS=300

# Storage warning bands for /status and check-server.sh.
STORAGE_WARN_PERCENT=75
STORAGE_CRITICAL_PERCENT=95

# Keep the last N backups; warn when the newest is older than N hours.
BACKUP_RETENTION=7
BACKUP_MAX_AGE_HOURS=48

# --- Admin console (v0.75) -------------------------------------------------
# The operator console at /admin is LAN-only but not open: it requires HTTP
# Basic credentials. With ADMIN_PASSWORD unset the console refuses every
# request rather than falling open. Generate one with:
#   openssl rand -base64 24
ADMIN_USERNAME=dancemate
ADMIN_PASSWORD=CHANGE_ME

# --- Source collector credentials (v0.75) ----------------------------------
# Without these the Source Master and the scheduler still work, but a source
# can only be collected from a recorded snapshot, not live. Never commit real
# values - this file holds variable names only.
#
# Kakao Developers -> REST API key, for the Daum Cafe Search API.
KAKAO_REST_API_KEY=
# Naver Developers -> application client id/secret, for the Blog/Cafe Search APIs.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

TZ=Asia/Seoul
