# The deployment target is Linux/ARM64 (ROCKPro64). Everything text in this
# repository checks out with LF, on Windows too, so that shell scripts, the
# Dockerfile and engine sources are never handed to bash with CRLF endings
# ("bash: \r: command not found").
* text=auto eol=lf

# Belt and braces for the files that break loudest on CRLF.
*.sh        text eol=lf
*.py        text eol=lf
*.sql       text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
.env.example text eol=lf
