{
  "version": "0.73",
  "daum": {
    "endpoint": "https://dapi.kakao.com/v2/search/cafe",
    "sort": "recency",
    "page": 1,
    "size": 50,
    "timeout_seconds": 15,
    "api_key_env": "KAKAO_REST_API_KEY"
  },
  "acquisition": {
    "strategy": "direct_http_then_cross_source_recovery",
    "full_body_min_chars": 40,
    "poster_candidate_policy": "all_discovered_images_with_asset_or_attach_hint",
    "failed_acquisition_action": "enqueue_recovery"
  },
  "cross_source_recovery": {
    "identity": "event_date + normalized venue + normalized event name",
    "auto_merge_policy": "date exact + venue exact + name similarity",
    "manual_review_on_ambiguity": true,
    "source_count_is_not_trust_score": true
  },
  "naver": {
    "blog_endpoint": "https://openapi.naver.com/v1/search/blog.json",
    "cafe_endpoint": "https://openapi.naver.com/v1/search/cafearticle.json",
    "display": 100,
    "start": 1,
    "sort": "date",
    "timeout_seconds": 15,
    "credentials": [
      "NAVER_CLIENT_ID",
      "NAVER_CLIENT_SECRET"
    ],
    "daily_search_api_limit_note": "25,000 calls/day per Naver Search API documentation"
  },
  "metrics": {
    "full_body_rate": "(FULL + BODY_ONLY) / acquisition_attempts",
    "poster_rate": "acquisition attempts with >=1 poster candidate / acquisition_attempts",
    "recovery_success_rate": "RESOLVED / recovery_attempts",
    "human_review_rate": "(pending recovery + conflicts) / discovered",
    "note": "PoC rates are operational metrics, not end-user trust scores."
  },
  "revision_roles": [
    "ORIGINAL",
    "UPDATE",
    "CANCELLATION"
  ],
  "freshness": {
    "CRITICAL": "<=3h",
    "HIGH": "<=12h",
    "MEDIUM": "<=24h",
    "NORMAL": ">24h",
    "critical_cancellation_miss_target": 0
  },
  "gate1_14d": {
    "period_days": 14,
    "pass": {
      "event_recall_min": 0.85,
      "verified_precision_min": 0.99,
      "core_field_accuracy_min": 0.98,
      "human_touch_rate_max": 0.2,
      "false_verified_max": 0,
      "hallucinated_core_field_max": 0,
      "critical_cancellation_miss_max": 0
    },
    "conditional_pass": {
      "event_recall_min": 0.8,
      "verified_precision_min": 0.99,
      "core_field_accuracy_min": 0.98,
      "human_touch_rate_max": 0.25
    }
  },
  "validation_admin": {
    "ground_truth_live": "data/validation_runtime/ground_truth_live.csv",
    "dancemate_results_live": "data/validation_runtime/dancemate_results_live.csv",
    "workflow": [
      "gt-add",
      "export-dm",
      "reconcile",
      "daily-report",
      "rolling-report"
    ]
  },
  "evidence_model": {
    "version": "0.2",
    "event_confidence": [
      "DISCOVERED",
      "POSSIBLE",
      "HIGH_CONFIDENCE",
      "VERIFIED",
      "CANCELLED",
      "CONFLICT"
    ],
    "field_confidence": [
      "VERIFIED",
      "EXPECTED",
      "INFERRED",
      "CONFLICT",
      "UNKNOWN"
    ],
    "event_verified_requires_fee_verified": false,
    "recurring_value_isolation": true,
    "occurrence_bound_core_evidence": true,
    "p0": [
      "FALSE_EVENT_VERIFIED",
      "FALSE_FIELD_VERIFIED",
      "HALLUCINATED_CORE_FIELD",
      "CRITICAL_CANCELLATION_MISS",
      "EXPECTED_AS_VERIFIED"
    ]
  },
  "media_classification": {
    "classes": [
      "EVENT_POSTER",
      "VENUE_IMAGE",
      "LOGO",
      "UNKNOWN"
    ],
    "poster_candidate_is_not_evidence": true
  },
  "source_model": {
    "authority_levels": [
      "PRIMARY_ORGANIZER",
      "PRIMARY_VENUE",
      "SECONDARY",
      "AGGREGATOR",
      "COMMUNITY",
      "UNKNOWN"
    ],
    "access_states": [
      "OPEN",
      "ACCESS_LIMITED",
      "LOGIN_REQUIRED",
      "BLOCKED",
      "FAILED",
      "UNKNOWN"
    ],
    "authority_independent_of_access": true
  },
  "evidence_metrics_v2": {
    "field_coverage_rate": "VERIFIED core fields / total core fields",
    "known_field_rate": "(VERIFIED+EXPECTED+INFERRED) / total core fields",
    "expected_to_verified_promotion_rate": "promoted expected fields / expected opportunities",
    "source_yield_rate": "MILONGA candidates / raw posts",
    "access_failure_rate": "PARTIAL+FAILED acquisition / acquisition attempts",
    "primary_recovery_success_rate": "RESOLVED / primary recovery attempts"
  },
  "observation_logging": {
    "complete_denominator_logging": true,
    "run_types": [
      "DISCOVERY",
      "ACQUISITION",
      "RECOVERY"
    ],
    "required_metrics": [
      "source_yield_rate",
      "access_failure_rate",
      "recovery_success_rate"
    ]
  },
  "observation_lineage": {
    "stages": [
      "DISCOVERY",
      "ACQUISITION",
      "RECOVERY",
      "EVENT"
    ],
    "correlation_required": true,
    "traceable_to_event_instance": true
  },
  "live_lineage_propagation": {
    "enabled": true,
    "stages": [
      "DISCOVERY",
      "ACQUISITION",
      "RECOVERY"
    ],
    "origin_candidate_before_recovery": true,
    "event_link": true
  },
  "lineage_aware_cli": {
    "enabled": true,
    "commands": [
      "collect-daum",
      "collect-daum-snapshot",
      "collect-naver",
      "collect-naver-snapshot",
      "acquire-daum",
      "acquire-daum-snapshot",
      "acquire-naver",
      "acquire-naver-snapshot",
      "recover-naver",
      "recover-naver-snapshot",
      "recover-cross-source-snapshot"
    ],
    "persist_across_cli_invocations": true,
    "auto_infer_parent_by_post_id": true
  },
  "daily_orchestrator": {
    "enabled": true,
    "stages": [
      "COLLECT",
      "ACQUIRE",
      "RECOVER",
      "METRICS",
      "REPORT"
    ],
    "snapshot_mode_enabled": true,
    "live_mode_enabled": false,
    "daily_root_correlation": true
  },
  "daily_operations_summary": {
    "enabled": true,
    "sections": [
      "event_confidence_distribution",
      "field_confidence_distribution",
      "source_operations",
      "recovery_status",
      "human_review_queue",
      "p0_errors"
    ],
    "health": [
      "GREEN",
      "YELLOW",
      "RED"
    ],
    "red_if_p0": true,
    "recovery_evidence_model_enforcement": true
  },
  "human_review": {
    "actions": [
      "APPROVE",
      "MODIFY",
      "REJECT",
      "HOLD"
    ],
    "audit_trail": true,
    "manual_verified_requires_evidence": true,
    "review_state_filters_queue": true
  },
  "human_in_loop_metrics": {
    "enabled": true,
    "metrics": [
      "manual_correction_rate",
      "machine_human_disagreement_rate",
      "manual_verified_override_rate",
      "approval_rate",
      "rejection_rate",
      "hold_rate",
      "average_review_turnaround_seconds",
      "evidence_backed_resolution_rate"
    ],
    "reviewer_reliability_mode": "PROXY_ONLY",
    "true_reviewer_reliability_requires_adjudication": true
  },
  "correction_hotspot": {
    "enabled": true,
    "dimensions": [
      "field",
      "source",
      "source_field"
    ],
    "hotspot_score": "3*(MODIFY+REJECT) + 2*HOLD + reviews",
    "priorities": {
      "P1": ">=6",
      "P2": ">=3",
      "P3": "<3"
    }
  },
  "improvement_backlog": {
    "enabled": true,
    "source": "correction_hotspots",
    "sample_confidence": {
      "LOW": "<3 reviews",
      "MEDIUM": "3-9 reviews",
      "HIGH": ">=10 reviews"
    },
    "acceptance_requires_regression_test": true,
    "verified_rules_must_not_be_bypassed": true
  },
  "backlog_lifecycle": {
    "statuses": [
      "OPEN",
      "IN_PROGRESS",
      "VERIFIED",
      "REJECTED"
    ],
    "capture_before_on": "OPEN->IN_PROGRESS",
    "capture_after_on": [
      "IN_PROGRESS->VERIFIED",
      "IN_PROGRESS->REJECTED"
    ],
    "effect_metrics": [
      "correction_rate",
      "access_failure_rate",
      "field_coverage_rate",
      "known_field_rate",
      "source_yield_rate",
      "recovery_success_rate"
    ]
  },
  "change_traceability": {
    "enabled": true,
    "flow": "Backlog -> Change -> Daily Run -> Metric Effect",
    "relations": [
      "BASELINE",
      "POST_CHANGE",
      "VALIDATION"
    ],
    "auto_link_unlinked_changes_on_daily_run": true,
    "effect_metrics": [
      "correction_rate",
      "access_failure_rate",
      "field_coverage_rate",
      "known_field_rate",
      "source_yield_rate",
      "recovery_success_rate"
    ]
  },
  "immutable_daily_metric_snapshot": {
    "enabled": true,
    "capture_on_daily_run_pass": true,
    "hash": "SHA-256 canonical JSON",
    "one_snapshot_per_daily_run": true,
    "change_effect_uses_snapshot": true
  },
  "automatic_change_effect_verdict": {
    "enabled": true,
    "auto_baseline": "latest PASS immutable snapshot before change registration",
    "auto_post_change": "first completed Daily Run without POST_CHANGE link",
    "verdicts": [
      "IMPROVED",
      "REGRESSED",
      "INCONCLUSIVE"
    ],
    "material_epsilon": 0.01,
    "lower_is_better": [
      "correction_rate",
      "access_failure_rate"
    ],
    "higher_is_better": [
      "field_coverage_rate",
      "known_field_rate",
      "source_yield_rate",
      "recovery_success_rate"
    ],
    "minimum_comparable_metrics": 2
  },
  "goal_aware_weighted_verdict": {
    "enabled": true,
    "profiles": [
      "FIELD_QUALITY",
      "SOURCE_ACCESS",
      "RECOVERY",
      "BALANCED"
    ],
    "weighted_score_thresholds": {
      "IMPROVED": ">=0.25",
      "REGRESSED": "<=-0.25",
      "INCONCLUSIVE": "between"
    },
    "primary_goal_regression_guard": true
  },
  "explicit_goal_profile": {
    "stored_on_backlog": true,
    "fields": [
      "goal_profile",
      "goal_weights_json"
    ],
    "profiles": [
      "FIELD_QUALITY",
      "SOURCE_ACCESS",
      "RECOVERY",
      "BALANCED"
    ]
  },
  "adaptive_goal_weighting": {
    "enabled": true,
    "mode": "FOUNDATION_CONSERVATIVE",
    "effective_after_observations": 10,
    "max_adjustment_pct": 25,
    "observation_source": "completed change verdict improved/regressed metrics",
    "automatic_weight_use_before_10_samples": false
  },
  "adaptive_shadow_verdict": {
    "enabled": true,
    "production_verdict": "BASE_WEIGHTS_ONLY",
    "shadow_verdict": "LATEST_ADAPTIVE_SUGGESTION",
    "no_current_sample_leakage": true,
    "idempotent_per_change_baseline_post_pair": true,
    "agreement_tracking": true,
    "promotion_policy": {
      "minimum_shadow_samples": 20,
      "minimum_agreement_rate": 0.9,
      "automatic_promotion": false
    }
  },
  "shadow_safety_gate": {
    "enabled": true,
    "policy_version": "v0.31",
    "statuses": [
      "OBSERVING",
      "BLOCKED",
      "ELIGIBLE"
    ],
    "minimum_shadow_samples": 20,
    "minimum_agreement_rate": 0.9,
    "critical_false_improved": "BASE=REGRESSED AND SHADOW=IMPROVED",
    "unsafe_improved": "BASE!=IMPROVED AND SHADOW=IMPROVED",
    "critical_false_improved_allowed": 0,
    "unsafe_improved_allowed": 0,
    "automatic_adaptive_promotion": false
  },
  "rolling_shadow_stability_gate": {
    "enabled": true,
    "policy_version": "v0.32",
    "windows": [
      7,
      14,
      30
    ],
    "minimum_agreement_rate": 0.9,
    "minimum_promotion_samples": 20,
    "recent_windows_required": [
      "7=STABLE",
      "14=STABLE",
      "30=STABLE when >=30 samples"
    ],
    "downgrade_detection": "ELIGIBLE -> BLOCKED",
    "promotion_candidate_generation": true,
    "automatic_adaptive_promotion": false,
    "human_approval_required": true
  },
  "human_approved_adaptive_promotion": {
    "enabled": true,
    "policy_version": "v0.33",
    "decisions": [
      "APPROVE",
      "REJECT",
      "HOLD"
    ],
    "approval_requires_rolling_status": "ELIGIBLE",
    "approval_requires_adaptive_observations": 10,
    "canary_mode": true,
    "default_max_canary_changes": 5,
    "max_canary_changes_limit": 20,
    "goal_profile_scoped": true,
    "unsafe_canary_optimism_guard": "BASE!=IMPROVED AND CANARY=IMPROVED -> immediate rollback",
    "rolling_blocked_guard": "active lease -> automatic rollback",
    "manual_rollback": true,
    "automatic_full_promotion": false
  },
  "canary_outcome_gate": {
    "enabled": true,
    "policy_version": "v0.34",
    "minimum_safe_completions": 3,
    "maximum_divergence_rate": 0.4,
    "false_optimism_allowed": 0,
    "lease_must_be_exhausted_for_final_promotion": true,
    "final_decisions": [
      "PROMOTE",
      "EXTEND",
      "ROLLBACK"
    ],
    "automatic_final_promotion": false,
    "human_final_approval_required": true,
    "full_promotion_emergency_rollback": true
  },
  "post_promotion_runtime_guard": {
    "enabled": true,
    "policy_version": "v0.35",
    "recent_windows": [
      7,
      14
    ],
    "max_recent7_divergence_rate": 0.4,
    "max_recent14_divergence_rate": 0.3,
    "max_drift_from_canary": 0.2,
    "false_optimism_allowed": 0,
    "stable_full_minimum_samples": 14,
    "fail_closed_rollback": true,
    "automatic_stable_full": true,
    "base_reference_always_on": true
  },
  "decision_quality_guard": {
    "enabled": true,
    "policy_version": "v0.36",
    "minimum_samples": 5,
    "maximum_failed_decision_rate": 0.2,
    "minimum_core_relevance_rate": 0.6,
    "critical_errors": [
      "FALSE_VERIFIED",
      "CANCELLATION_MISS"
    ],
    "critical_error_action": "BLOCKED",
    "support_only_status": "GOAL_MISMATCH",
    "post_promotion_fail_closed_integration": true
  },
  "decision_outcome_evidence_automation": {
    "enabled": true,
    "policy_version": "v0.37",
    "automatic_sources": [
      "EVENT_REFRESH_CHECK",
      "EVENT_REVISION",
      "HUMAN_REVIEW"
    ],
    "visit_feedback_sources": [
      "VISITED_HELD",
      "ARRIVED_NO_EVENT",
      "CANCELLED_BEFORE_VISIT"
    ],
    "workflow": [
      "PENDING",
      "HOLD",
      "CONFIRMED",
      "REJECTED"
    ],
    "auto_confirm": false,
    "human_confirmation_required": true,
    "confirmed_evidence_creates_decision_quality_observation": true,
    "critical_candidates": [
      "FALSE_VERIFIED",
      "CANCELLATION_MISS"
    ],
    "deduplicate_by_evidence_key": true
  },
  "evidence_priority_queue": {
    "enabled": true,
    "policy_version": "v0.38",
    "priority_order": [
      "P0",
      "P1",
      "P2"
    ],
    "p0_errors": [
      "FALSE_VERIFIED",
      "CANCELLATION_MISS"
    ],
    "sla_hours": {
      "P0": 0.5,
      "P1_default": 4,
      "P1_event_availability": 2,
      "P2": 24
    },
    "multi_source_corroboration": {
      "two_sources": "HIGH_CORROBORATED",
      "three_sources": "VERY_HIGH"
    },
    "stale_pending_auto_expire_hours": 72,
    "automatic_confirm": false,
    "automatic_reject": false,
    "automatic_expire_noncritical_low_medium_only": true,
    "critical_evidence_never_auto_expires": true,
    "multi_source_corroboration_never_auto_confirms": true
  },
  "evidence_cluster_resolution": {
    "enabled": true,
    "policy_version": "v0.39",
    "cluster_key": [
      "event_instance_id",
      "proposed_event_truth",
      "critical_error_type"
    ],
    "human_confirmation_resolves_case": true,
    "multi_source_pending_does_not_resolve": true,
    "critical_root_cause_attribution_required": true,
    "repeated_critical_root_cause_backlog_threshold": 2,
    "critical_backlog_priority": "P1",
    "automatic_backlog_creation_for_repeated_confirmed_critical_root_causes": true
  },
  "cluster_closure_gate": {
    "enabled": true,
    "human_close_required": true,
    "critical_case_requires_root_cause": true,
    "critical_case_requires_linked_backlog": true,
    "critical_case_requires_verified_backlog": true,
    "unresolved_critical_evidence_blocks_closure": true,
    "automatic_close": false
  },
  "source_reliability_feedback": {
    "enabled": true,
    "policy_version": "v0.40",
    "internal_only": true,
    "base_score": 1.0,
    "critical_failure_penalty": 0.2,
    "confirmed_success_recovery": 0.025,
    "score_floor": 0.2,
    "trusted_threshold": 0.9,
    "watch_threshold": 0.7,
    "bands": [
      "TRUSTED",
      "WATCH",
      "DEGRADED"
    ],
    "critical_failures_from_confirmed_root_cause_only": true,
    "missing_source_attribution_does_not_penalize_any_source": true,
    "existing_verified_events_never_auto_downgraded": true
  },
  "preventive_verification_policy": {
    "enabled": true,
    "policy_version": "v0.40",
    "default_mode": "SHADOW",
    "watch_requirement": ">=2 independent sources OR human confirmation",
    "degraded_requirement": ">=2 independent sources AND human confirmation",
    "trusted_extra_requirement": "none",
    "existing_verified_action": "KEEP_EXISTING_VERIFIED",
    "automatic_canary_start": false,
    "minimum_shadow_decisions_before_canary": 3,
    "human_approval_required_for_canary": true,
    "canary_max_decisions_range": [
      1,
      20
    ]
  },
  "preventive_policy_outcome_evaluation": {
    "enabled": true,
    "policy_version": "v0.41",
    "ground_truth_requires_human_confirmation": true,
    "outcome_classes": [
      "PREVENTED_CRITICAL_FAILURE",
      "FALSE_CONSERVATIVE_HOLD",
      "MISSED_CRITICAL_FAILURE",
      "CORRECT_ALLOW",
      "NEUTRAL"
    ],
    "minimum_canary_outcomes": 3,
    "maximum_false_conservative_hold_rate": 0.25,
    "minimum_prevented_critical_failures_for_promotion": 1,
    "canary_must_be_exhausted_for_final_review": true
  },
  "preventive_canary_safety_gate": {
    "automatic_full_promotion": false,
    "human_final_review_required": true,
    "final_decisions": [
      "PROMOTE",
      "ROLLBACK",
      "HOLD"
    ],
    "full_mode": "FULL_PREVENTIVE",
    "existing_verified_events_never_auto_downgraded": true,
    "full_promotion_rollback_supported": true
  },
  "preventive_full_runtime_guard": {
    "enabled": true,
    "policy_version": "v0.42",
    "runtime_ground_truth_requires_human_confirmation": true,
    "missed_critical_failure_immediate_block": true,
    "recent5_false_conservative_hold_block_threshold": 0.4,
    "recent10_false_conservative_hold_block_threshold": 0.3,
    "stable_sample_count": 10,
    "stable_recent10_false_hold_threshold": 0.2,
    "blocked_action": "FAIL_CLOSED_ROLLBACK",
    "rollback_target": "BASE_WITH_SHADOW",
    "existing_verified_events_never_modified": true,
    "automatic_runtime_rollback": true,
    "automatic_repromotion": false
  },
  "preventive_runtime_recovery": {
    "enabled": true,
    "policy_version": "v0.43",
    "automatic_recovery_case_on_fail_closed_rollback": true,
    "root_cause_human_review_required": true,
    "remediation_reference_required": true,
    "minimum_post_rollback_shadow_decisions": 3,
    "minimum_human_confirmed_recovery_outcomes": 3,
    "maximum_false_conservative_hold_rate": 0.25,
    "missed_critical_failure_allowed": 0,
    "all_recovery_outcomes_must_be_safe": true,
    "human_requalification_required": true,
    "new_canary_blocked_until_requalified": true,
    "automatic_requalification": false,
    "automatic_repromotion": false
  },
  "preventive_recurrence_guard": {
    "enabled": true,
    "policy_version": "v0.44",
    "baseline": {
      "recurrence_count": 1,
      "shadow_decisions": 3,
      "confirmed_outcomes": 3,
      "max_false_hold_rate": 0.25
    },
    "elevated": {
      "recurrence_count": 2,
      "shadow_decisions": 5,
      "confirmed_outcomes": 5,
      "max_false_hold_rate": 0.2
    },
    "restricted": {
      "recurrence_count_gte": 3,
      "shadow_decisions": 7,
      "confirmed_outcomes": 7,
      "max_false_hold_rate": 0.1
    },
    "same_root_cause_repeat_escalates_to_restricted": true,
    "prior_requalified_remediation_followed_by_new_rollback_is_ineffective": true,
    "restricted_requires_human_exception": true,
    "automatic_exception_approval": false,
    "automatic_repromotion": false,
    "existing_verified_events_never_modified": true
  },
  "preventive_quarantine": {
    "enabled": true,
    "policy_version": "v0.45",
    "trigger_after_requalified_restricted_failure": true,
    "mandatory_recurrence_count_gte": 4,
    "production_mode": "QUARANTINE_SHADOW",
    "production_action": "QUARANTINE_HOLD",
    "minimum_quarantine_hours": 24,
    "minimum_shadow_decisions": 7,
    "minimum_human_confirmed_outcomes": 7,
    "maximum_false_conservative_hold_rate": 0.1,
    "minimum_independent_alternative_decisions": 3,
    "trigger_recovery_must_be_requalified_before_release": true,
    "human_release_review_required": true,
    "release_decisions": [
      "APPROVE",
      "DENY",
      "HOLD"
    ],
    "max_first_reintegration_canary_decisions": 3,
    "automatic_release": false,
    "automatic_repromotion": false,
    "existing_verified_events_never_modified": true
  },
  "alternative_source_routing": {
    "enabled": true,
    "policy_version": "v0.47",
    "exclude_active_quarantined_sources": true,
    "source_independence_basis": "Source Independence Graph",
    "unknown_independence_never_counts_as_independent": true,
